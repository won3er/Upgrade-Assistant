{
  "name": "@upgrade-assistant/plugin-typescript",
  "version": "0.1.0",
  "description": "TypeScript migration plugin for Upgrade Assistant — compiler-option and language breaking changes across TypeScript releases.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
