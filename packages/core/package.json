{
  "name": "@upgrade-assistant/core",
  "version": "0.1.0",
  "description": "Core migration engine for Upgrade Assistant: project scanning, dependency resolution, AST analysis, migration planning and execution.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
